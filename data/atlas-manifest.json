{
  "$schema": "./schema/atlas-manifest.schema.json",
  "datasetId": "heavens-remember-atlas",
  "schemaVersion": "1.0.0",
  "datasetVersion": "0.1.0-draft",
  "defaultLocale": "ru",
  "supportedLocales": ["ru", "en"],
  "contentLocales": ["ru", "en"],
  "license": "CC-BY-SA-4.0",
  "attribution": "Heavens Remember editorial board",
  "layers": [
    {
      "id": "editorial",
      "files": [
        "constellation-editorial.json",
        "constellation-editorial.en.json",
        "constellation-stars.json",
        "constellation-stars.en.json"
      ],
      "license": "CC-BY-SA-4.0",
      "redistributable": true,
      "containsThirdPartyExcerpts": true
    },
    {
      "id": "astronomy-hyg",
      "source": "https://codeberg.org/astronexus/hyg",
      "version": "4.1",
      "license": "CC-BY-SA-4.0",
      "redistributable": true
    },
    {
      "id": "stellarium-modern",
      "source": "https://github.com/Stellarium/stellarium/tree/v26.1/skycultures/modern",
      "version": "26.1",
      "license": "CC-BY-SA-4.0",
      "redistributable": true
    },
    {
      "id": "stellarium-artwork",
      "source": "https://github.com/Stellarium/stellarium/tree/v26.1/skycultures/modern/illustrations",
      "version": "26.1",
      "license": "FAL-1.3",
      "redistributable": true,
      "separateAssetBundle": true
    },
    {
      "id": "quoted-text",
      "license": "edition-specific",
      "redistributable": false,
      "metadataOnlyByDefault": true
    }
  ]
}
